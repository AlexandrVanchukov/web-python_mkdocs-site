{
  "name": "python-static-site",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build:css": "postcss theme/css/styles.css -o theme/css/styles.min.css",
    "validate:html": "htmlhint site/**/*.html",
    "minify:html": "html-minifier --remove-comments --collapse-whitespace --input-dir ./site --output-dir . --file-ext html;",
    "build": "npm run build:css && mkdocs build --clean && npm run minify:html"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.6",
    "html-minifier": "^4.0.0",
    "htmlhint": "^1.1.4",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0"
  }
}
